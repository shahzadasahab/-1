<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".CoachingApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.CsxiCoaching">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".UnitActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".LessonActivity"
            android:exported="false"
            android:parentActivityName=".UnitActivity" />
        <activity
            android:name=".QuizActivity"
            android:exported="false"
            android:parentActivityName=".UnitActivity" />
        <activity
            android:name=".GlossaryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".DiagramActivity"
            android:exported="false"
            android:parentActivityName=".LessonActivity" />
    </application>
</manifest>
