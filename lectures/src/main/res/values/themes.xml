<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LectureNotes" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="BlockBody" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="BlockHeading" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BlockCode" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="BlockCaption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textStyle">italic</item>
    </style>
</resources>
